# ---------------------------------------------------------------------------
# Copia este ficheiro para .env e preenche apenas o que precisares.
# Todas as variáveis são opcionais: o site funciona offline com os assets
# locais em client/public/media.
# ---------------------------------------------------------------------------

# Umami / analytics. Sem valores o script não é carregado (ver client/index.html).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Envio do formulário (POST /api/pedido, ver server/index.ts). Sem estas
# variáveis o endpoint responde 503 e o formulário recua para o `mailto:`.
# SMTP da Hostinger: smtp.hostinger.com, porta 587 (STARTTLS) ou 465 (SSL).
# SMTP_PASS é a password da caixa formacao@3dhr.pt — nunca vai para o repositório.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=formacao@3dhr.pt
SMTP_PASS=
# Destino do pedido e nome no "De:". Por omissão: formacao@3dhr.pt / 3DHR Formação.
MAIL_TO=formacao@3dhr.pt
MAIL_FROM_NAME=3DHR Formação

# Manus Forge storage proxy — só precisa de existir se algum asset voltar a
# referenciar /manus-storage/<ficheiro>. O proxy está em vite.config.ts.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Porta do servidor de produção (pnpm start). Por omissão: 3000.
# PORT=3000
